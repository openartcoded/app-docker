# artcoded cli (docker compose exec cli artcoded ...)
# "artcoded init" writes the configuration in ./datacli/conf.yml (gitignored);
# the ARTCODED_<KEY> variables win over the file.
ARTCODED_CONFIG=/data/conf.yml

# inside the docker network: plain http, no certificate to trust
# (the backend checks the signature of the tokens with JWK_SET_URI, not their issuer)
ARTCODED_BACKEND_URL=http://api-backend
ARTCODED_KEYCLOAK_URL=http://keycloak:8080
ARTCODED_REALM=Artcoded
# a public client with "Direct access grants" enabled
ARTCODED_CLIENT_ID=artcoded-cli
ARTCODED_LOGIN_METHOD=password
ARTCODED_SPARQL_ENDPOINT=http://triplestore/sparql
# the links of --online, opened in your browser
ARTCODED_FRONTEND_URL=https://v2.backoffice.somehost.org

# the image is updated with docker compose pull
DISABLE_AUTO_UPDATE=true
# the whatsapp bot: prod only
ENABLE_WHATSAPP_BOT=false
